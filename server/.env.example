# Backend port
PORT=5000

# Database name (optional; server.js defaults to 'smilecare')
MONGODB_DB=smilecare

# MongoDB Atlas connection string
# IMPORTANT: Do NOT commit real credentials. Copy this file to .env and fill in.
# If your password has special characters, URL-encode it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority

# If you use the non-SRV Atlas URI (multiple hosts), it also works:
# MONGODB_URI=mongodb://<username>:<password>@host1:27017,host2:27017,host3:27017/<dbName>?ssl=true&replicaSet=<replicaSet>&authSource=admin&appName=<appName>
