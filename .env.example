# Generated QA values are written to testing/.env.test by prepare-env.js.
# Never place real credentials or a production connection string in this file.
MONGODB_URI=mongodb://127.0.0.1:27017/smilecare_ci_test
MONGODB_DB=smilecare_ci_test
JWT_SECRET=generate-a-random-local-value
ADMIN_USER=qa-admin-<random>@gmail.com
LOCKED_USER=qa-locked-<random>@gmail.com
DOCTOR_USER=qa-doctor-<random>@gmail.com
RECEPTION_USER=qa-reception-<random>@gmail.com
ADMIN_PASS=generate-a-random-password
DOCTOR_PASS=generate-a-random-password
RECEPTION_PASS=generate-a-random-password
PORT=5000
BASE_URL=http://localhost:5173
API_URL=http://localhost:5000/api
